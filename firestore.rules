rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == 'hamroghar106@gmail.com' ||
          request.auth.token.email.lower() == 'bhaktipokhrel2004@gmail.com'
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['tenantId', 'title', 'content', 'status', 'authorId', 'createdAt'])
        && data.keys().hasOnly(['tenantId', 'title', 'description', 'content', 'body', 'imageUrl', 'status', 'scheduledAt', 'scheduledDate', 'sourceLinks', 'socialLinks', 'showAds', 'adSlotId', 'bottomAdSlotId', 'upvotesCount', 'downvotesCount', 'score', 'commentsCount', 'authorId', 'authorName', 'authorEmail', 'createdAt', 'updatedAt'])
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 64
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 50000
        && (data.status == 'public' || data.status == 'private' || data.status == 'scheduled' || data.status == 'draft')
        && data.authorId is string && data.authorId == request.auth.uid
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('body' in data) || (data.body is string && data.body.size() <= 50000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1500000))
        && (!('scheduledAt' in data) || (data.scheduledAt is string && data.scheduledAt.size() <= 64))
        && (!('scheduledDate' in data) || (data.scheduledDate is string && data.scheduledDate.size() <= 64))
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 128))
        && (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('sourceLinks' in data) || (data.sourceLinks is list && data.sourceLinks.size() <= 10))
        && (!('socialLinks' in data) || (data.socialLinks is list && data.socialLinks.size() <= 10))
        && (!('showAds' in data) || (data.showAds is bool))
        && (!('adSlotId' in data) || (data.adSlotId is string && data.adSlotId.size() <= 64))
        && (!('bottomAdSlotId' in data) || (data.bottomAdSlotId is string && data.bottomAdSlotId.size() <= 64))
        && (!('upvotesCount' in data) || (data.upvotesCount is int || data.upvotesCount is float))
        && (!('downvotesCount' in data) || (data.downvotesCount is int || data.downvotesCount is float))
        && (!('score' in data) || (data.score is int || data.score is float))
        && (!('commentsCount' in data) || (data.commentsCount is int || data.commentsCount is float));
    }

    function isValidComment(data, postId) {
      return data.keys().hasAll(['id', 'postId', 'authorId', 'authorName', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'postId', 'authorId', 'authorName', 'authorEmail', 'authorPhotoUrl', 'content', 'createdAt', 'updatedAt'])
        && data.authorId == request.auth.uid
        && data.postId == postId
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 128;
    }

    function isValidVote(data, postId, userId) {
      return data.keys().hasAll(['postId', 'userId', 'vote', 'createdAt'])
        && data.keys().hasOnly(['postId', 'userId', 'vote', 'createdAt', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.postId == postId
        && (data.vote == 1 || data.vote == -1);
    }

    // Blog Posts Collection with Multi-Tenant & Privacy Protections
    match /posts/{postId} {
      allow get: if resource.data.status == 'public' || (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      allow list: if resource.data.status == 'public' || (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && isValidId(postId) && isValidBlogPost(incoming());
      
      // Updates allowed either for full post authors/admins, OR for signed-in users updating vote/comment counters
      allow update: if isSignedIn() && isValidId(postId) && (
        ((resource.data.authorId == request.auth.uid || isAdmin())
          && isValidBlogPost(incoming())
          && incoming().createdAt == resource.data.createdAt)
        ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'downvotesCount', 'score', 'commentsCount', 'updatedAt']))
      );
      
      allow delete: if isSignedIn() && isValidId(postId) && (resource.data.authorId == request.auth.uid || isAdmin());

      // Comments Subcollection (ONLY signed-in users can post comments)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming(), postId);
        allow update: if isSignedIn() && isValidId(commentId)
          && (existing().authorId == request.auth.uid || isAdmin())
          && incoming().authorId == existing().authorId
          && incoming().postId == postId
          && incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000;
        allow delete: if isSignedIn() && isValidId(commentId) && (existing().authorId == request.auth.uid || isAdmin());
      }

      // Votes Subcollection (ONLY signed-in users can Up arrow or Down arrow)
      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidVote(incoming(), postId, userId);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // User Profiles & Author Approvals
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().approved == existing().approved && incoming().status == existing().status && incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }
  }
}
