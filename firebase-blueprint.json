{
  "entities": {
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog article supporting image, title, body content, sources, social links, public/private status, scheduling, and multi-tenant scoping.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 64,
          "description": "Tenant identifier for multi-tenant isolation"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Title of the blog post"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Short summary or description"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "Markdown or full formatted blog post content"
        },
        "body": {
          "type": "string",
          "maxLength": 50000,
          "description": "Full blog post body text"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "Featured header image URL for the post"
        },
        "status": {
          "type": "string",
          "enum": ["public", "private", "scheduled", "draft"],
          "description": "Visibility status of post"
        },
        "scheduledAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional ISO timestamp when scheduled to go public"
        },
        "scheduledDate": {
          "type": "string",
          "maxLength": 64,
          "description": "Target publication date string (ISO format)"
        },
        "sourceLinks": {
          "type": "array",
          "description": "List of reference sources"
        },
        "socialLinks": {
          "type": "array",
          "description": "List of social links"
        },
        "showAds": {
          "type": "boolean",
          "description": "Whether AdSense dynamic in-article units are active"
        },
        "upvotesCount": {
          "type": "number",
          "description": "Total count of up-arrow votes"
        },
        "downvotesCount": {
          "type": "number",
          "description": "Total count of down-arrow votes"
        },
        "score": {
          "type": "number",
          "description": "Calculated article rank score (upvotes minus downvotes)"
        },
        "commentsCount": {
          "type": "number",
          "description": "Total count of user comments"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of author"
        },
        "authorName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name or email of author"
        },
        "authorEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of author"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["tenantId", "title", "content", "status", "authorId", "createdAt"]
    },
    "ArticleComment": {
      "title": "Article Comment",
      "description": "A user-submitted comment on a blog article by an authenticated user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Comment ID"
        },
        "postId": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent blog post ID"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of commenting user"
        },
        "authorName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name or email of user"
        },
        "authorEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of author"
        },
        "authorPhotoUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "Avatar URL of author"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Comment content text"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of comment creation"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "postId", "authorId", "authorName", "content", "createdAt"]
    },
    "ArticleVote": {
      "title": "Article Vote",
      "description": "Up arrow (+1) or down arrow (-1) vote cast by a signed-in user for ranking",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent blog post ID"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of voter"
        },
        "vote": {
          "type": "number",
          "enum": [1, -1],
          "description": "Upvote (+1) or Downvote (-1)"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp when vote was cast"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last change"
        }
      },
      "required": ["postId", "userId", "vote", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with role and approval status for authoring blog posts",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase user ID"
        },
        "email": {
          "type": "string",
          "maxLength": 128,
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 2048,
          "description": "Avatar photo URL"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "author", "reader"],
          "description": "User permission role"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval status for authoring"
        },
        "approved": {
          "type": "boolean",
          "description": "Whether user is approved by administrator"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Account registration timestamp"
        },
        "approvedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Timestamp when approved"
        },
        "approvedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Email of admin who approved"
        }
      },
      "required": ["uid", "email", "role", "status", "approved", "createdAt"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "BlogPost",
      "description": "Collection of blog articles"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "ArticleComment",
      "description": "Subcollection of comments on an article, restricted to signed-in users"
    },
    "/posts/{postId}/votes/{userId}": {
      "schema": "ArticleVote",
      "description": "Subcollection of up/down votes for article ranking, restricted to signed-in users"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles and author approvals"
    }
  }
}
